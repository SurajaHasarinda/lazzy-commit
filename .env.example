# ---------------------------------------------------------------------------
# Lazzy Commit — legacy .env configuration (OPTIONAL)
# ---------------------------------------------------------------------------
# In the enhanced version the recommended way to configure everything is the
# settings UI:  lazzycommit config
#
# This .env still works for backward compatibility. Anything set here is used as
# a fallback; values saved through the settings UI (config.json) take priority.
# The one thing it is still ideal for is the API key, because keeping the secret
# in .env (gitignored) avoids writing it into config.json.
# ---------------------------------------------------------------------------

# Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_api_key_here

# Gemini model to use
GEMINI_MODEL=gemini-2.0-flash

# --- The settings below are now better managed from `lazzycommit config` ---

# Validation Settings
MAX_SUBJECT_LENGTH=72

# Security Settings
CHECK_API_KEYS=true
CHECK_SENSITIVE_DATA=true

# Format Settings
ENFORCE_CONVENTIONAL_COMMITS=true
ENFORCE_LENGTH_LIMIT=true

# Override Settings
ALLOW_OVERRIDE=true
